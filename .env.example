# Huawei Cloud MaaS Statistics — environment template
# Copy to .env (or export these) and fill in. NEVER commit real secrets.
#
# Minimal setup (3 values) — everything else has sane defaults:
#   HWCLOUD_PROJECT_ID
#   HWCLOUD_OIDC_ISSUER
#   HWCLOUD_OIDC_CLIENT_ID

# === Minimal (required) =====================================================
HWCLOUD_PROJECT_ID=your-project-id
HWCLOUD_OIDC_ISSUER=https://your-oidc-issuer.example.com
HWCLOUD_OIDC_CLIENT_ID=your-oidc-client-id

# === Optional ===============================================================
# Region defaults to ap-southeast-1.
# HWCLOUD_REGION=ap-southeast-1
# Timezone defaults to the detected user timezone.
# HWCLOUD_TIMEZONE=Asia/Shanghai

# Confidential client only (public/PKCE clients leave it empty):
# HWCLOUD_OIDC_CLIENT_SECRET=

# OIDC defaults: scope "openid profile", local callback port 8765.
# HWCLOUD_OIDC_SCOPE=openid profile
# HWCLOUD_OIDC_PORT=8765

# Only if you cannot use issuer discovery (set both endpoints explicitly):
# HWCLOUD_OIDC_AUTHORIZE_URL=
# HWCLOUD_OIDC_TOKEN_URL=

# Needed to exchange the OIDC id_token for an IAM token (to call MaaS APIs):
# HWCLOUD_IDP_ID=
# HWCLOUD_IAM_EXCHANGE_URL=      # default: https://iam.{region}.myhuaweicloud.com/v3.0/OS-AUTH/id-token/tokens
