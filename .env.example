# Huawei Cloud MaaS Statistics — environment template
# Copy to .env (or export these) and fill in. NEVER commit real secrets.

# --- Required ---------------------------------------------------------------
HWCLOUD_PROJECT_ID=your-project-id

# --- Region / timezone ------------------------------------------------------
HWCLOUD_REGION=ap-southeast-1
# HWCLOUD_TIMEZONE=Asia/Shanghai        # default: detected user timezone

# --- OIDC login: Authorization Code + PKCE ----------------------------------
# Get these from the OIDC application your tenant administrator registered.
HWCLOUD_OIDC_AUTHORIZE_URL=https://your-idp.example.com/oauth2/authorize
HWCLOUD_OIDC_TOKEN_URL=https://your-idp.example.com/oauth2/token
HWCLOUD_OIDC_CLIENT_ID=your-oidc-client-id
# Public/native client (PKCE) -> leave secret empty.
# Confidential client -> set secret (keep it out of source control):
# HWCLOUD_OIDC_CLIENT_SECRET=
HWCLOUD_OIDC_SCOPE=openid profile
# Local callback port; the redirect URI must be http://127.0.0.1:<port>/callback
HWCLOUD_OIDC_PORT=8765

# Optional: exchange the OIDC id_token for an IAM X-Auth-Token (needed to call MaaS)
# HWCLOUD_IDP_ID=
# HWCLOUD_IAM_EXCHANGE_URL=

# --- Optional override / fallback -------------------------------------------
# HWCLOUD_TOKEN=                        # temporary X-Auth-Token, overrides saved login
# HWCLOUD_AK=                          # optional AK/SK fallback
# HWCLOUD_SK=
# MAAS_ENDPOINT=
